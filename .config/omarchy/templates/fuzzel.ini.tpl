[main]
terminal=kitty
font=Cascadia Code NF:size=11
prompt=Run:
icon-theme=Adwaita

[colors]
background={{ background_strip }}
text-color={{ foreground_strip }}
match-color={{ accent_strip }}
selection-color={{ accent_strip }}
selection-text-color={{ background_strip }}
border-color={{ accent_strip }}

[border]
width=2
radius=6
