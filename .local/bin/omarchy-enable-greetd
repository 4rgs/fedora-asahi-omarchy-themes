#!/bin/bash
# Enable greetd + gtkgreet as display manager (needs root)
# Usage: sudo omarchy-enable-greetd

set -e

if ! command -v greetd &>/dev/null || ! command -v gtkgreet &>/dev/null; then
    echo "Installing greetd and gtkgreet..."
    dnf install -y greetd gtkgreet greetd-selinux
fi

# ── greetd daemon config ──
mkdir -p /etc/greetd

cat > /etc/greetd/config.toml << 'EOF'
[terminal]
vt = 1

[default_session]
command = "sway --config /etc/greetd/greetd-sway-config"
user = "greeter"
EOF

# ── Greeter Sway config ──
cat > /etc/greetd/greetd-sway-config << 'SWAYEOF'
# Minimal Sway config for greetd greeter
exec swaybg -i /var/lib/greeter/.config/omarchy/current/sddm-bg -m fill
exec gtkgreet

input type:keyboard {
    xkb_layout "latam"
    xkb_options "ctrl:nocaps"
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

default_border pixel 1

include /etc/sway/config.d/*
SWAYEOF

# ── Ensure greeter user has config dirs ──
GREETER_HOME=$(getent passwd greeter | cut -d: -f6)
mkdir -p "$GREETER_HOME/.config/gtkgreet" "$GREETER_HOME/.config/omarchy/current"

# Copy initial theme files if they exist
if [ -f "/home/4rgs/.config/omarchy/current/gtkgreet.css" ]; then
    cp "/home/4rgs/.config/omarchy/current/gtkgreet.css" "$GREETER_HOME/.config/gtkgreet/style.css"
fi
if [ -f "/home/4rgs/.config/omarchy/current/sddm-bg" ]; then
    cp "/home/4rgs/.config/omarchy/current/sddm-bg" "$GREETER_HOME/.config/omarchy/current/sddm-bg"
fi
chown -R greeter:greeter "$GREETER_HOME/.config"

# ── Disable SDDM, enable greetd ──
systemctl disable --now sddm 2>/dev/null || true
systemctl enable --now greetd

echo "greetd enabled with gtkgreet."
echo "Theme will sync automatically when running omarchy-theme-set."
