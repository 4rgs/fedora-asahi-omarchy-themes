#!/bin/bash
# Enable greetd + gtkgreet as display manager (needs root)
# Usage: sudo omarchy-enable-greetd

ORIG_USER="${SUDO_USER:-$USER}"
ORIG_HOME="$(getent passwd "$ORIG_USER" | cut -d: -f6)"

if ! command -v greetd &>/dev/null || ! command -v gtkgreet &>/dev/null; then
    echo "Installing greetd and gtkgreet..."
    dnf install -y greetd gtkgreet greetd-selinux
fi

# ── Create greeter user if missing ──
if ! id -u greeter &>/dev/null; then
    echo "Creating greeter user..."
    useradd -r -s /bin/bash -d /var/lib/greeter greeter
fi

# Ensure greeter has proper groups for GPU/input access
usermod -a -G video,input greeter 2>/dev/null
getent group seat &>/dev/null && usermod -a -G seat greeter 2>/dev/null || true

# Ensure greeter has a writable home
mkdir -p /var/lib/greeter
chown greeter:greeter /var/lib/greeter

# ── greetd daemon config ──
mkdir -p /etc/greetd

cat > /etc/greetd/config.toml << EOF
[terminal]
vt = 1

[default_session]
command = "sway --config /etc/greetd/greetd-sway-config"
user = "greeter"
EOF

# ── Greeter Sway config (no /etc/sway/config.d/* — those need systemd user session) ──
cat > /etc/greetd/greetd-sway-config << SWAYEOF
# Minimal Sway config for greetd greeter
set $bg_path $ORIG_HOME/.config/omarchy/current/sddm-bg
set $css_path $ORIG_HOME/.config/omarchy/current/gtkgreet.css

exec_always swaybg -i $bg_path -m fill
exec_always gtkgreet --css $css_path

input type:keyboard {
    xkb_layout "latam"
    xkb_options "ctrl:nocaps"
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

default_border pixel 1
SWAYEOF

# ── Environment for the greeter (GDK backend, path, etc.) ──
mkdir -p /etc/systemd/system/greetd.service.d
cat > /etc/systemd/system/greetd.service.d/override.conf << SYSTEMDEOF
[Service]
Environment=GDK_BACKEND=wayland
Environment=PATH=/usr/local/bin:/usr/bin:/bin
SYSTEMDEOF
systemctl daemon-reload

# ── Disable SDDM, enable greetd ──
systemctl disable --now sddm 2>/dev/null || true
systemctl enable --now greetd

echo "greetd enabled with gtkgreet."
echo "Theme reads directly from ~/.config/omarchy/current/"
echo "Run omarchy-theme-set <theme> to update the greeter."
