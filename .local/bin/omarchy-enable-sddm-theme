#!/bin/bash
# Enable themed SDDM login screen (needs root once)
# Usage: sudo omarchy-enable-sddm-theme

ORIG_USER="${SUDO_USER:-$USER}"
ORIG_HOME="$(getent passwd "$ORIG_USER" | cut -d: -f6)"
THEME_SRC="$ORIG_HOME/.config/sddm/themes/omarchy"
THEME_DST="/usr/share/sddm/themes/omarchy"

if [ ! -d "$THEME_SRC" ]; then
    echo "SDDM theme not found. Run omarchy-theme-set <theme> first."
    exit 1
fi

# Copy theme to system location
mkdir -p "$THEME_DST"
cp -r "$THEME_SRC"/* "$THEME_DST/"

# Change ownership so omarchy-theme-set can write without sudo
chown -R "$ORIG_USER:$ORIG_USER" "$THEME_DST"

# Create SDDM config
tee /etc/sddm.conf.d/omarchy-theme.conf > /dev/null <<-EOF
[Theme]
Current=omarchy
CursorTheme=Adwaita
EOF

echo "SDDM theme enabled at $THEME_DST"
echo "Theme changes apply on next login."
