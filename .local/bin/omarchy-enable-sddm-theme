#!/bin/bash
# Enable themed SDDM login screen (needs root once)
# Usage: sudo omarchy-enable-sddm-theme

THEME_SRC="$HOME/.config/sddm/themes/omarchy"

if [ ! -d "$THEME_SRC" ]; then
    echo "SDDM theme not found. Run omarchy-theme-set <theme> first."
    exit 1
fi

# Point SDDM directly to the user's local theme directory
# This way omarchy-theme-set updates are picked up automatically
sudo tee /etc/sddm.conf.d/omarchy-theme.conf > /dev/null <<-EOF
[Theme]
Current=omarchy
ThemeDir=/home/4rgs/.config/sddm/themes
CursorTheme=Adwaita
EOF

echo "SDDM theme enabled — reads directly from ~/.config/sddm/themes/omarchy/"
echo "Theme changes apply on next login without needing sudo."
