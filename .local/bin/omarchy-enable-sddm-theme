#!/bin/bash
# Enable themed SDDM login screen (requires root)
# Usage: sudo omarchy-enable-sddm-theme

THEME_SRC="$HOME/.config/sddm/themes/omarchy"

if [ ! -d "$THEME_SRC" ]; then
    echo "SDDM theme not found. Run omarchy-theme-set <theme> first."
    exit 1
fi

# Copy theme to system location so it persists across sessions
sudo mkdir -p /usr/share/sddm/themes/omarchy
sudo cp "$THEME_SRC"/*.qml /usr/share/sddm/themes/omarchy/ 2>/dev/null
sudo cp "$THEME_SRC"/*.conf /usr/share/sddm/themes/omarchy/ 2>/dev/null
sudo cp "$THEME_SRC"/*.png /usr/share/sddm/themes/omarchy/ 2>/dev/null
sudo cp "$THEME_SRC"/*.jpg /usr/share/sddm/themes/omarchy/ 2>/dev/null
sudo cp "$THEME_SRC"/*.desktop /usr/share/sddm/themes/omarchy/ 2>/dev/null
sudo cp "$THEME_SRC"/*.svg /usr/share/sddm/themes/omarchy/ 2>/dev/null

# Create SDDM config that uses the system theme
sudo tee /etc/sddm.conf.d/omarchy-theme.conf > /dev/null <<-EOF
[Theme]
Current=omarchy
CursorTheme=Adwaita

[General]
DisplayServer=wayland
EOF

# Link the background so SDDM can access it
sudo mkdir -p /usr/share/sddm/themes/omarchy
sudo ln -sf "$HOME/.config/omarchy/current/sddm-bg" /usr/share/sddm/themes/omarchy/background 2>/dev/null

echo "SDDM theme enabled. It will apply on next login."
echo "Run 'sudo omarchy-update-sddm-theme' after changing themes to sync."
