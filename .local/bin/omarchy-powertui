#!/bin/bash
# Power management TUI — omarchy-style with fzf

BAT="/sys/class/power_supply/macsmc-battery"
AC="/sys/class/power_supply/macsmc-ac"

rd() { cat "$1" 2>/dev/null || echo "0"; }

status=$(rd "$BAT/status")
capacity=$(rd "$BAT/capacity")
power=$(rd "$BAT/power_now"); power="${power#-}"; power=$(echo "scale=1; $power/1000000" | bc 2>/dev/null)
health=$(echo "scale=1; $(rd "$BAT/energy_full")*100/$(rd "$BAT/energy_full_design")" | bc 2>/dev/null)
cycles=$(rd "$BAT/cycle_count")
temp=$(echo "scale=1; $(rd "$BAT/temp")/10" | bc 2>/dev/null)
tt_e=$(rd "$BAT/time_to_empty_now")
tt_f=$(rd "$BAT/time_to_full_now")

fmt_time() {
    local m=$(( $1 / 60 ))
    echo "$(( m / 60 ))h $(( m % 60 ))m"
}

if [ "$status" = "Charging" ] && [ "$tt_f" -gt 0 ] 2>/dev/null; then
    time_str="$(fmt_time $tt_f) until full"
elif [ "$status" = "Discharging" ] && [ "$tt_e" -gt 0 ] 2>/dev/null; then
    time_str="$(fmt_time $tt_e) remaining"
else
    time_str=""
fi

draw_bar() {
    local pct=$1 w=${2:-12}
    local n=$(( pct * w / 100 ))
    [ "$n" -gt "$w" ] && n=$w
    local col="\033[38;2;167;192;128m"  # green
    [ "$pct" -le 50 ] && col="\033[38;2;219;188;127m"  # yellow
    [ "$pct" -le 20 ] && col="\033[38;2;230;126;128m"  # red
    printf "%b" "$col"
    printf '█%.0s' $(seq 1 $n)
    printf "\033[38;2;71;82;88m"
    printf '░%.0s' $(seq 1 $(( w - n )))
    printf "\033[38;2;220;215;186m"
}

clear
echo ""
echo -e "  \033[1m⚡ Omarchy Power Manager\033[0m"
echo -e "  \033[2m──────────────────────────────────────\033[0m"
echo ""
if [ "$status" = "Charging" ]; then
    echo -e "  🔌 \033[38;2;127;187;179m$status\033[38;2;220;215;186m  |  $(draw_bar $capacity 15)  $capacity%"
else
    echo -e "  🔋 \033[38;2;127;187;179m$status\033[38;2;220;215;186m  |  $(draw_bar $capacity 15)  $capacity%"
fi
[ -n "$time_str" ] && echo -e "  ⏱  \033[38;2;127;187;179m$time_str\033[38;2;220;215;186m"
echo -e "  ⚡ ${power}W  |  ❤ \033[38;2;167;192;128m${health}%\033[38;2;220;215;186m  |  🔄 ${cycles}  |  🌡 ${temp}°C"
echo ""
echo -e "  \033[2m──────────────────────────────────────\033[0m"
echo ""

choice=$(printf "🔋 Battery Info\n⚡ Power Profile\n💤 Suspend\n⏹  Shutdown\n🔄 Reboot\n🔒 Lock Screen" | fzf --height=10 --prompt="❯ " --reverse --no-info 2>/dev/null)

case "$choice" in
    "💤 Suspend")
        systemctl suspend
        ;;
    "⏹  Shutdown")
        systemctl poweroff
        ;;
    "🔄 Reboot")
        systemctl reboot
        ;;
    "🔒 Lock Screen")
        swaylock --config "$HOME/.config/swaylock/config"
        ;;
    "⚡ Power Profile")
        clear
        echo ""
        echo -e "  \033[1m🔋 Power Profile\033[0m"
        echo ""
        profiles=$(powerprofilesctl list 2>/dev/null | grep '^\s\+\w' | sed 's/[:*]//' | sed 's/^ *//')
        if [ -z "$profiles" ]; then
            echo -e "  \033[38;2;230;126;128mNo power profiles available\033[38;2;220;215;186m"
        else
            pf=$(echo "$profiles" | fzf --height=8 --prompt="❯ " --reverse --no-info 2>/dev/null)
            if [ -n "$pf" ]; then
                powerprofilesctl set "$pf" 2>/dev/null && \
                    echo -e "\n  \033[38;2;167;192;128m✔ $pf\033[38;2;220;215;186m" || \
                    echo -e "\n  \033[38;2;230;126;128m✘ failed to set $pf\033[38;2;220;215;186m"
            fi
        fi
        echo -e "\n  \033[2mPress Enter to exit\033[0m"
        read -r
        ;;
    "🔋 Battery Info"|"")
        [ -z "$choice" ] && exit 0
        ;;
esac
