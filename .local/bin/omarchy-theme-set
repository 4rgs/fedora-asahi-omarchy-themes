#!/bin/bash
# Apply Omarchy theme to all system components

THEMES_DIR="$HOME/.config/omarchy/themes"
TEMPLATES_DIR="$HOME/.config/omarchy/templates"
THEME_NAME="$1"

hex_to_rgb() {
    local h="$1"
    printf "%d,%d,%d" 0x"${h:1:2}" 0x"${h:3:2}" 0x"${h:5:2}"
}

usage() {
    echo "Usage: omarchy-theme-set <theme-name>"
    echo ""
    echo "Available themes:"
    for d in "$THEMES_DIR"/*/; do
        echo "  $(basename "$d")"
    done
    exit 1
}

[ -n "$THEME_NAME" ] || usage

THEME_DIR="$THEMES_DIR/$THEME_NAME"
[ -d "$THEME_DIR" ] || { notify-send -u critical "Theme error" "'$THEME_NAME' not found"; exit 1; }

COLORS_FILE="$THEME_DIR/colors.toml"
[ -f "$COLORS_FILE" ] || { notify-send -u critical "Theme error" "No colors.toml"; exit 1; }

echo "$THEME_NAME" > "$HOME/.config/omarchy/current/theme.name"

# Parse colors.toml
declare -A COLORS
while IFS='=' read -r key value; do
    key="${key//[[:space:]\"]/}"
    value="${value//[[:space:]\"]/}"
    [[ -z "$key" || "$key" == \#* ]] && continue
    COLORS["$key"]="$value"
done < "$COLORS_FILE"

process_template() {
    local tpl="$1" output="$2"
    [ -f "$tpl" ] || return 1
    cp "$tpl" "$output"
    for key in "${!COLORS[@]}"; do
        value="${COLORS[$key]}"
        sed -i "s|{{ $key }}|$value|g" "$output"
        sed -i "s|{{ ${key}_strip }}|${value#\#}|g" "$output"
        if [[ "$value" == \#* ]]; then
            sed -i "s|{{ ${key}_rgb }}|$(hex_to_rgb "$value")|g" "$output"
        fi
    done
}

# ── Core components ────────────────────────────────────
process_template "$TEMPLATES_DIR/waybar.css.tpl"   "$HOME/.config/waybar/style.css"
process_template "$TEMPLATES_DIR/mako.conf.tpl"     "$HOME/.config/mako/config"
process_template "$TEMPLATES_DIR/fuzzel.ini.tpl"    "$HOME/.config/fuzzel/fuzzel.ini"
process_template "$TEMPLATES_DIR/kitty.conf.tpl"    "$HOME/.config/kitty/kitty.conf"
mkdir -p "$HOME/.config/swaylock"
process_template "$TEMPLATES_DIR/swaylock.conf.tpl" "$HOME/.config/swaylock/config"
mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
process_template "$TEMPLATES_DIR/gtk.css.tpl"      "$HOME/.config/gtk-3.0/gtk.css"
process_template "$TEMPLATES_DIR/gtk.css.tpl"      "$HOME/.config/gtk-4.0/gtk.css"

# Theme-specific overrides
[ -f "$THEME_DIR/waybar.css" ]   && cp "$THEME_DIR/waybar.css"   "$HOME/.config/waybar/style.css"
[ -f "$THEME_DIR/mako.ini" ]     && cp "$THEME_DIR/mako.ini"     "$HOME/.config/mako/config"
[ -f "$THEME_DIR/kitty.conf" ]   && cp "$THEME_DIR/kitty.conf"   "$HOME/.config/kitty/kitty.conf"
[ -f "$THEME_DIR/swayosd.css" ]  && cp "$THEME_DIR/swayosd.css"  "$HOME/.config/swayosd/style.css" 2>/dev/null

# ── Btop ───────────────────────────────────────────────
if [ -d "$HOME/.config/btop" ]; then
    mkdir -p "$HOME/.config/btop/themes"
    if [ -f "$THEME_DIR/btop.theme" ]; then
        cp "$THEME_DIR/btop.theme" "$HOME/.config/btop/themes/$THEME_NAME.theme"
        sed -i "s|^color_theme = .*|color_theme = \"$THEME_NAME\"|" "$HOME/.config/btop/btop.conf"
    fi
fi

# ── Neovim ─────────────────────────────────────────────
if command -v nvim &>/dev/null && [ -f "$THEME_DIR/neovim.lua" ]; then
    mkdir -p "$HOME/.config/nvim/lua/plugins"
    cp "$THEME_DIR/neovim.lua" "$HOME/.config/nvim/lua/plugins/theme.lua"
fi

# ── Bat ────────────────────────────────────────────────
if command -v bat &>/dev/null; then
    mkdir -p "$HOME/.config/bat"
    cat > "$HOME/.config/bat/config" <<-EOF
# Generated by omarchy-theme-set
# Use "bat --list-themes" to see available themes
EOF
fi

# ── Chromium theme ─────────────────────────────────────
if command -v chromium-browser &>/dev/null && [ -f "$THEME_DIR/chromium.theme" ]; then
    cp "$THEME_DIR/chromium.theme" "$HOME/.config/omarchy/current/chromium.theme"
fi

# ── SDDM (login screen) ────────────────────────────────
process_template "$TEMPLATES_DIR/sddm-Main.qml.tpl" "$HOME/.config/sddm/themes/omarchy/Main.qml"

# Update SDDM theme.conf with current background
cat > "$HOME/.config/sddm/themes/omarchy/theme.conf" <<-EOF
[General]
background=$HOME/.config/omarchy/current/sddm-bg
EOF

# Copy background for SDDM
mkdir -p "$HOME/.config/omarchy/current"
SDDM_BG="$HOME/.config/omarchy/current/sddm-bg"
mapfile -t sddm_bgs < <(find "$HOME/.config/omarchy/backgrounds" -type f \( -iname '*.jpg' -o -iname '*.png' \) 2>/dev/null)
if [ ${#sddm_bgs[@]} -gt 0 ]; then
    cp "${sddm_bgs[RANDOM % ${#sddm_bgs[@]}]}" "$SDDM_BG" 2>/dev/null
elif [ -n "$bg" ]; then
    cp "$bg" "$SDDM_BG" 2>/dev/null
fi
chmod 644 "$SDDM_BG" 2>/dev/null

# ── greetd / gtkgreet (login screen) ────────────────────
process_template "$TEMPLATES_DIR/gtkgreet.css.tpl" "$HOME/.config/omarchy/current/gtkgreet.css"
chmod 644 "$HOME/.config/omarchy/current/gtkgreet.css" 2>/dev/null

# ── VS Code theme ──────────────────────────────────────
if flatpak list 2>/dev/null | grep -q com.visualstudio.code; then
    VSCODE_DIR="$HOME/.config/Code/User"
    mkdir -p "$VSCODE_DIR"
    if [ -f "$THEME_DIR/vscode.json" ]; then
        cat > "$VSCODE_DIR/settings.json" <<-EOF
{
    "workbench.colorTheme": "Omarchy",
    "workbench.iconTheme": "omarchy-icons",
    "window.titleBarStyle": "custom"
}
EOF
    fi
fi

# ── Wallpaper ──────────────────────────────────────────
pkill swaybg 2>/dev/null
BG_DIR="$HOME/.config/omarchy/backgrounds/$THEME_NAME"
mapfile -t bgs < <(find "$BG_DIR" -type f \( -iname '*.png' -o -iname '*.jpg' \) 2>/dev/null)
if [ ${#bgs[@]} -gt 0 ]; then
    swaybg -i "${bgs[RANDOM % ${#bgs[@]}]}" -m fill &>/dev/null &
else
    swaybg -i /usr/share/backgrounds/sway/default -m fill &>/dev/null 2>/dev/null || true
fi
disown

# ── Restart UI components ──────────────────────────────
pkill mako 2>/dev/null
pkill waybar 2>/dev/null
sleep 0.3
waybar &>/dev/null &
mako &>/dev/null &
disown

notify-send -i preferences-desktop-color "Theme" "$THEME_NAME applied (waybar + kitty + btop + nvim + GTK + swaylock)"
